<Window x:Class="Amethyst925.Windows.Views.BranchView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Amethyst925.Windows.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Amethyst925.Windows.ViewModels"
        Title="Administración de Sucursales"
        Width="800"
        Height="600"
        mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16"
                    Orientation="Horizontal">
            <materialDesign:PackIcon Width="32"
                                     Height="32"
                                     Margin="0,0,8,0"
                                     Kind="Store" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="20"
                       Text="Administración de Sucursales" />
        </StackPanel>

        <!--  List View  -->
        <DataGrid Grid.Row="1"
                  Margin="0,0,0,16"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding Branches}"
                  SelectedItem="{Binding SelectedBranch}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="Auto"
                                    Binding="{Binding Id}"
                                    Header="ID" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Name}"
                                    Header="Nombre" />
                <DataGridTextColumn Width="2*"
                                    Binding="{Binding Address}"
                                    Header="Dirección" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Phone}"
                                    Header="Teléfono" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Email}"
                                    Header="Email" />
            </DataGrid.Columns>
        </DataGrid>

        <!--  Buttons  -->
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding NewBranchCommand}"
                    Content="Nueva" />
            <Button Margin="0,0,8,0"
                    Command="{Binding EditBranchCommand}"
                    Content="Editar"
                    IsEnabled="{Binding SelectedBranch, Converter={StaticResource NullToBooleanConverter}}" />
            <Button Margin="0,0,8,0"
                    Command="{Binding DeleteBranchCommand}"
                    Content="Eliminar"
                    IsEnabled="{Binding SelectedBranch, Converter={StaticResource NullToBooleanConverter}}" />
        </StackPanel>

        <!--  Edit Form  -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Background="#80000000"
              Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="400"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource MaterialDesignPaper}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               FontSize="16"
                               Text="{Binding SelectedBranch.Id, StringFormat='Sucursal: {0}', TargetNullValue='Nueva Sucursal'}" />

                    <TextBox Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Nombre"
                             Text="{Binding SelectedBranch.Name, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Dirección"
                             Text="{Binding SelectedBranch.Address, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Teléfono"
                             Text="{Binding SelectedBranch.Phone, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Margin="0,0,0,16"
                             materialDesign:HintAssist.Hint="Email"
                             Text="{Binding SelectedBranch.Email, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding SaveBranchCommand}"
                                Content="Guardar" />
                        <Button Command="{Binding CancelEditCommand}"
                                Content="Cancelar" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>